# Application
APP_NAME=Third-Party Attack Surface Monitor
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
FERNET_KEY=generate-with-python-cryptography-fernet

# Server (bind localhost only by default)
HOST=127.0.0.1
PORT=8000
OPEN_BROWSER=true

# Database (SQLite by default; set DATABASE_URL for PostgreSQL later)
DATABASE_URL=sqlite:///./data/tpm.db

# Session
SESSION_COOKIE_NAME=tpm_session
SESSION_MAX_AGE_SECONDS=28800

# File storage
FILE_STORAGE_PATH=./data/files
MAX_UPLOAD_MB=25

# Retention (days) for leak identifiers
LEAK_RETENTION_DAYS=180

# Optional connectors (leave blank to disable)
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
HIBP_API_KEY=
GITHUB_TOKEN=

# Rate limiting for light-active scans
SCAN_RATE_LIMIT_RPS=5